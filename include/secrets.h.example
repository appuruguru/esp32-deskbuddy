#pragma once

// Copy this file to secrets.h and fill it in. secrets.h is git-ignored; never share it.
// WiFi is optional here: with no network set, the board opens a "DeskBuddy-XXXX" hotspot for setup from a phone.
// Networks saved through that hotspot override these two values.
#define WIFI_SSID "YOUR_WIFI_NAME"      // 2.4 GHz network only (the ESP32 cannot use 5 GHz)
#define WIFI_PASS "YOUR_WIFI_PASSWORD"

// Personal settings for the clock/weather screen.
// WEATHER_LAT / WEATHER_LON: decimal degrees as text, e.g. "40.71" and "-74.01". "0" = not set.
// TZ_POSIX: POSIX timezone string, e.g. "EST5EDT,M3.2.0,M11.1.0" (US Eastern) or "UTC0".
#define WEATHER_LAT "0"
#define WEATHER_LON "0"
#define TZ_POSIX "UTC0"
#define USE_FAHRENHEIT 1
#define CLOCK_24H 0
